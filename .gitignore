public/tv_series.csv
public/*.bak
# CsvStore.update writes here, then os.replace()s it over tv_series.csv (left only if the process dies mid-write)
public/.tv_series-*.csv.tmp

node_modules/
dist/
# sub-path build used by npm run e2e:subpath
dist-sub/
coverage/
*.tsbuildinfo
# stale root output of `tsc -b` before tsconfig.node.json got an outDir — delete if present
# (vite and vitest would load a leftover vite.config.js instead of vite.config.ts)
vite.config.js
vite.config.d.ts
# Vite's temporary bundled config (left behind if the process dies while loading vite.config.ts)
vite.config.*.timestamp-*
.vite/
.env
.env.local
.env.*.local
*.local
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
.claude/plans/
.claude/sessions/
.claude/memory/
__pycache__/
*.pyc
*.pyo
scratch_*.png
.claude/settings.local.json

# vite-plugin-pwa dev output (devOptions) — never committed
dev-dist/

